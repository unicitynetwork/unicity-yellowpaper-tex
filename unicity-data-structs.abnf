; Unicity Protocol Data Structures (ABNF)

; ============================================================================
; 1. BFT CORE (shared data structures)

  UC = Version IR TechRecordHash ShardConfHash ShardTreeCertificate UnicityTreeCertificate UnicitySeal  ;~$UC = (IR, h_t, h_c, C^\mathsf{shard}, C^\mathsf{uni}, C^\mathsf{r})$
  IR = Version RoundNumber Epoch NullableHash NullableHash NullableBytes Time NullableHash EarnedFees NullableHash
      ; CBOR tag 39002, array[10]: $[1,n,e,h',h,v,t,h_B,f,h_E]$
  ; The empty aggregation state root is NULL, never an empty bstr or a zero digest.
  ; IR and UC themselves are required records.
  NullableHash = Hash / NULL
  NullableBytes = Bytes / NULL
  EarnedFees = uint64
  ShardTreeCertificate = Version ShardIdentifier *SiblingHash  ;~$C^\mathsf{shard} = (\sigma;h^s_1, \ldots, h^s_{|\sigma|})$
  ; Exactly one sibling per shard bit, leaf-to-root; no null path entries.
  UnicityTreeCertificate = Version PartitionIdentifier *HashStep
  HashStep = PartitionIdentifier SiblingHash  ;~$C^\mathsf{uni} = (\beta; (\beta_2, h_2), \ldots, (\beta_\ell, h_\ell)))$

  UnicitySeal = Version NetworkIdentifier RootPartitionRoundNumber Epoch Timestamp PreviousHash Hash *Signatures  ;~$C^\mathsf{r} = (\alpha, n_r, e_r, t_r, r_-, r; s)$
                      ; Count each valid trusted signer once; valid voting power >= quorumThreshold.
                      ; Tag 39005, array[8]; signing uses NULL in the signature-map slot.
                      ; PreviousHash commits to QC VoteInfo in the distributed implementation.

  PartitionView = Version PartitionIdentifier 1*8PartitionViewLeaf
      ; Untagged [1, partition, [leaves...]], canonical complete topological order.
      ; At most 16 KiB; shard <= 256 bits, IR <= 1024 bytes, summary <= 256 bytes.
      ; These are consolidation admission limits, not consensus limits.
  PartitionViewLeaf = ShardIdentifier IR TechRecordHash ShardConfHash
      ; Exact four-element array; retain every native IR field.
  NativeCReS = PartitionIdentifier ShardIdentifier TechRecord UC
      ; Untagged four-element array; abstract CReS below also names network context.
  CReSV2 = Version NativeCReS (PartitionViewBytes / NULL)
      ; [2, response, sidecar]; absent sidecar is NULL, not an empty byte string.
  PartitionViewBytes = Bytes
      ; Nonempty byte string containing a complete encoded PartitionView.

; --- Statistical and Technical Records ---
  StatisticalRecord = NumRounds SumRoundSize SumStateSize MaxRoundSize MaxStateSize ;~$\mathsf{SR}=(n_e, \overline{\ell}_B, \overline{\ell}_S, \hat{\ell}_B, \hat{\ell}_S)$
  TechRecord = Round Epoch LeaderID SRHash FeeHash  ;~$\mathsf{TE}=(n_r, e_r, \nu_\ell, h_\mathsf{sr}, h_\mathsf{fee})$

  ShardInfo = Round PreviousHash PrevStatisticalRecord StatisticalRecord *ValidatorIdentifier LeaderIdentifier PrevUC ;~$(n,h_-, \mathsf{SR}_-, \mathsf{SR}, \mathcal{V}, \nu_\ell, UC_-)$

  ; Evolving trust base:
  UnicityTrustBase = Version *UnicityTrustBaseEntry
  UnicityTrustBaseEntry = NetworkIdentifier Epoch *(NodeID Pubkey Stake) QuorumThreshold StateHash ChangeRecordHash PreviousEntryHash *Signatures

; ============================================================================
; BFT CORE (internal data structures)

; --- Internal Consensus Structures ---
  LedgerCommitInfo = UnicitySeal | UnicityTrustBaseEntry ; seal without signatures
  QC = VoteInfo LedgerCommitInfo *Signatures
      ; LedgerCommitInfo.PreviousHash = H(VoteInfo).
  RecoverableSignature = 65OCTET
      ; R || S || V: nonzero scalars, low S, V in 0..3; recover the expected key.

  VoteInfo = RoundInfo
  RoundInfo = RoundNumber Epoch Timestamp ParentRoundNumber CurrentRootHash | UnicityTrustBaseEntryHash

; --- BFT Core Messages ---
  VoteMsg = VoteInfo LedgerCommitInfo HighQC Author Signature

  ProposalMsg = BlockData [LastRoundTc] Signature
  BlockData   = Author Round Epoch Timestamp Payload AncestorQC
  Payload     = *IRChangeReq | RPEpochChangeReq
  IRChangeReq = PartitionIdentifier CertReason *CR [EpochChangeJustification] SenderSignature
              ; presence of justification ==> epoch++
  RPEpochChangeReq = Epoch *(NodeID Pubkey Stake) QuorumThreshold StateHash ChangeRecordHash PreviousEntryHash SenderSignature [ChangeRecord]

  TimeoutMsg = Timeout Author Signature [LastTC]
      ;~If HighQC is not from prev. round then there must be TC of prev,
      ;~justifying the incremented round number
  Timeout = Epoch Round HighQC   ;~HighQC - highest known Quorum Certificate to the validator
  TC = Timeout *Signatures ;~2f+1 Signatures  ;~TC - Timeout Certificate

  CertReason    = 'quorum' | 'quorum-not-possible' | 't2-timeout'  ;~flags in appropriate encoding

; --- Recovery Messages ---
  GetStateMsg = NodeId   ; id of the validator requesting the state
  StateMsg = CommittedHead *BlockData
      ; CBOR [committedHead, [pending blocks...]].
  CommittedHead = BlockData *RecoveredShardInfo QC CommitQC
      ; CBOR [block, [shard info...], qc, commitQc].
  RecoveredShardInfo = PartitionIdentifier ShardIdentifier T2Timeout NullableHash
                      PreviousStatisticsBytes NativeStatisticalRecord PreviousFeesBytes FeeRecord
                      UC TechRecord IR TechRecord ShardConfHash
      ; One array[13]; final TechRecord is IRTR; retained UC and TR are required.
  NativeStatisticalRecord = NumBlocks SumFees SumBlockSize SumStateSize MaxFee MaxBlockSize MaxStateSize
  FeeRecord = *(NodeID EarnedFees)
      ; CBOR map from validator identifiers to earned fees.
  PreviousStatisticsBytes = Bytes
  PreviousFeesBytes = Bytes

; ============================================================================
; 3. BFT CORE (protocols)

  CR = NetworkIdentifier PartitionIdentifier Shard NodeIdentifier IR BatchSize StateSize Signature [ConsistencyProof]
  ; Certification Request $CR = \langle \alpha, \beta, \sigma, \nu; \mathcal{IR},\ell_B,\ell_S; s; [\pi_{CP}]\rangle$
  ;  Returned UC can be repeated cert for prevStateTreeHash which triggers next attempt using different leader
  ;  a validator can have multiple pending requests extending the same hash; latest one is identified using IR.n

  CReS = NetworkIdentifier PartitionIdentifier ShardIdentifier UC TechRecord [UnicityTrustBaseEntry]
        ;~Certification~Response

  ; Subscription - Subscribe to CReS message feed in order to obtain the latest UC for synchronization
  SubscriptionMsg = NetworkIdentifier PartitionIdentifier Shard NodeIdentifier signature
        ; this request provides or updates validator connection parameters at
        ; transport layer so that Root can return CReS messages

  ; Trust Base Distribution protocol
  GetTrustBaseMsg = NetworkIdentifier EpochStart [EpochEnd]
  TrustBaseResponse = *UnicityTrustBaseEntry

; ============================================================================
; 4. AGGREGATION LAYER

; The aggregation layer uses a Radix Sparse Merkle Tree (RSMT, Appendix~\ref{app:rsmt}).
; Leaf-anchored: leaf hashes commit to the full 256-bit key; junction hashes
; commit to the bifurcation depth $d$ and the region $p$ (key prefix, packed).
; Keys are read as 256-bit big-endian bit strings; depth $d$ addresses bit $d$.

  StateIdentifier = Bytes32  ;~$\mathsf{sid} = H(\mathsf{CBOR}(\nu, h_{\mathsf{st}}))$ -- SMT leaf key
  LeafData = Bytes32  ;~$v=\mathsf{SHA256}(\mathsf{CBOR}([h_{\mathsf{tx}},\tau]))$
  SMTLeaf = StateIdentifier LeafData  ;~$L = (\mathsf{sid}, v)$

  CertificatePath = Bitmap *SiblingHash  ;~$(\mathit{bitmap}, \langle s_1, \ldots, s_n \rangle)$ -- shared by both certificate types
      ;~bitmap: 32 bytes; bit $d$ is the $(d \bmod 8)$-th most significant bit of byte $\lfloor d/8 \rfloor$
      ;~bit $d$ set iff the certified path has a junction at bifurcation depth $d$
      ;~siblings: exactly $n = \mathsf{bitcount}(\mathit{bitmap})$ hashes, root-to-leaf order
      ;~depths come from the bitmap; regions are derived by the verifier, never transmitted

  InclusionCertificate = CertificatePath  ;~$C^\mathsf{inc} = (\mathit{bitmap}, \mathit{siblings})$
      ;~certified leaf is the queried $(k,v)$: supplied by the verifier, not carried here
      ;~verifier derives each region as $k[0..d)$ from the queried key
      ;~Wire: $\mathit{bitmap}[32] \,\|\, s_1[32] \,\|\, \ldots \,\|\, s_n[32]$

  NonInclusionCertificate = [CertificatePath SMTLeaf]  ;~$C^\mathsf{exc}_\emptyset$ or $(\mathit{bitmap},\mathit{siblings};k',v')$
      ;~terminal: $SMTLeaf = (k',v')$, the leaf reached by key-directed descent for the queried key
      ;~verifier derives regions from $k'$, requires $k[d]=k'[d]$ at every junction, and requires $k' \ne k$
      ;~empty (zero-length): admissible only for an empty tree
      ;~Wire: $\mathit{bitmap}[32]\,\|\,s_1[32]\,\|\cdots\|\,s_n[32]\,\|\,k'[32]\,\|\,v'$

  InclusionProof = Version CertificationData ReferenceTime InclusionCertificateBytes UC
      ; Tag 39033, array[5]; the query and leaf value are verifier inputs.
      ; The original reference time is not replaced by a later UC timestamp.
  ReferenceTime = Timestamp
  InclusionCertificateBytes = Bytes
      ; Byte-string encoding of InclusionCertificate.

  NonInclusionProof = Version NonInclusionCertificateBytes UC  ;~$\pi^\mathsf{exc} = (C^\mathsf{exc}, UC)$
      ; Tag 39034, array[3]: [1, certificate byte string, native tagged UC].
      ; Certificate bytes are empty or exactly 96 + 32*popcount(bitmap), <= 8288.
      ; Terminal value is 32 bytes; no trailing bytes.
      ;~Proves that a queried $\mathsf{sid}$ does NOT exist in the SMT; the queried
      ;~$\mathsf{sid}$ is supplied by the verifier and is not carried in the proof

  NonInclusionCertificateBytes = Bytes
  UnavailableInclusionAnswer = Version NULL NULL NULL UC
      ; Tag 39033, [1, null, null, null, UC]; not a proof of absence.

  ConsistencyProof = *ConsistencyProofOp | ZKProof
      ;~$\pi_{\mathsf{CP}}$ -- proves append-only consistency of the SMT round update;
      ;~accompanied by the sorted round batch for hash-based verification
  ConsistencyProofOp = OpS | OpL | OpN | OpO | OpOL  ;~post-order flat opcode stream
  OpS = %x00 Hash    ;~S(h): preserved subtree, opaque, 33 bytes
  OpL = %x01          ;~L: new leaf (consumed from sorted batch), 1 byte
  OpN = %x02 Depth    ;~N(d): junction at bifurcation depth $d$, 2 bytes; region derived by verifier
  OpO = %x03 Depth Region Hash Hash  ;~$O(d, p, h_L, h_R)$: preserved junction opened one level, 98 bytes
  OpOL = %x04 Key Bytes  ;~$O_L(k, v)$: preserved leaf opened, $33 + |v|$ bytes
  Depth = OCTET       ;~$d \in \{0, \ldots, 255\}$
  Region = Bytes32    ;~$\langle p \rangle$: region packed as a 256-bit big-endian bit string, suffix cleared
  Bitmap = Bytes32    ;~256-bit branching-depth vector
  ZKProof = Bytes     ;~Opaque ZK proof (SNARK/STARK)

; ============================================================================
; 5. EXECUTION LAYER

  AggregationPartitionIdentifier = PartitionIdentifier
      ; Must equal the token/aggregation profile constant in Sec. 2 (Execution Model).
      ; Applies to every application UC, including nested and consolidated proofs.

; --- Predicates ---
  Predicate = Engine Code Params  ;~$\nu = (\mathsf{engine}, \mathsf{code}, \mathsf{params})$ -- CBOR array[3]
      ;~Engine: unsigned integer (1 = BUILT\_IN)
      ;~Code: byte string, built-in type code (see below)
      ;~Params: byte string or CBOR item (encoding depends on predicate type)

  ; Built-in predicate type codes and parameter encodings:
  ;   0x01  sig   -- Signature:           pk (33-byte bstr)
  ;   0x02  burn  -- Burn:                reason hash (32-byte bstr)
  ;   0x03  tlock -- Timelock:            CBOR array[2]: [pk, $\tau_{min}$ (uint)]
  ;   0x04  p2pkh -- Pay-to-Public-Key-Hash: $h_{pk}$ (32-byte bstr)
  ;   0x05  p2sh  -- Pay-to-Script-Hash:  $h_{pred}$ = H(CBOR(pred')) (32-byte bstr)
  ;   0x06  msig  -- Multi-signature:     CBOR array of $pk_i$
  ;   0x07  tsig  -- Threshold-signature: CBOR array[2]: [k (uint), [$pk_1$,...,$pk_n$]]
  ;   0x08  htlc  -- Hashed Timelock:     CBOR array[4]: [pk, pk', y (32-byte bstr), $\tau_{max}$ (uint)]

; --- Unlocking Arguments ---
  ; Encoding of $u$ depends on current owner's predicate type:
  ;   sig / tlock : signature s (65 bytes, R||S||V)
  ;   burn        : none (predicate never evaluates to 1)
  ;   p2pkh       : CBOR array[2]: [pk, s]
  ;   p2sh        : CBOR array[2]: [CBOR(pred') (bstr), u' (bstr)]
  ;   msig        : CBOR array of n signatures [$s_1$,...,$s_n$]
  ;   tsig        : CBOR array of k entries, each CBOR array[2]: [$s_i$, $j_i$ (uint)]
  ;   htlc        : CBOR array[2]: [x (bstr), s (65-byte bstr)]

; --- Transactions ---
  MintTransaction = Version NetworkIdentifier Recipient Salt TokenType NullableBytes NullableBytes ExpiresAt
      ; Tag 39041, array[8], version 2; reason, data and timeout keep their positions.
      ; Token identifier is derived from salt and network.

  TransferTransaction = Version Recipient StateMask NullableBytes ExpiresAt
      ; Tag 39045, array[5], version 2.
      ; Source state and unlocking argument are checked through certification data.

  CertifiedMintTransaction = MintTransaction InclusionProof  ;~$(T_0, \pi)$ -- CBOR array[2]
  CertifiedTransferTransaction = TransferTransaction InclusionProof  ;~$(T, \pi)$ -- CBOR array[2]

  Token = Version CertifiedMintTransaction *CertifiedTransferTransaction
      ;~$\mathcal{L} = (T_0^\mathsf{cert}, T_1^\mathsf{cert}, \ldots, T_n^\mathsf{cert})$ -- tag 39040, array[3]: [2, genesis, [transfers...]]

; --- Fields ---
  Salt = Bytes32  ;~$\mathsf{salt}$ -- 32-byte minter-chosen salt, required to be unique among the minter's choices
  ; used to derive token identifier $\mathsf{id} = H(\mathsf{salt}, \alpha)$
  TokenType = Bytes  ;~$\mathsf{ty}$ -- token type classifier (32 bytes generated as a convention, anything supported)
  MintReason = Bytes  ;~$\mathsf{reason}$ -- mint reason (justification)
  SourceStateHash = Hash  ;~$h_\mathsf{st}$ -- current state hash (32 bytes)
  UnlockingArgument = Bytes  ;~$\mathsf{CBOR}(u)$ -- CBOR-encoded unlocking argument (see above)
  Recipient = Bytes  ;~$\mathsf{CBOR}(\nu')$ -- CBOR-encoded next owner predicate
                    ;~(use $\predi_\mathsf{p2sh}$ to commit only to a hash)
  StateMask = Bytes32  ;~$x \overset{\$}{\leftarrow}  \{0,1\}^{256}$ -- random value for state derivation
  Data = Bytes  ;~$\auxd'$ -- auxiliary payload (optional, arbitrary length)
  TransactionHash = Hash  ;~$h_\mathsf{tx}$ -- SHA-256 of the complete tagged native transaction, including timeout
  UnlockScript = Bytes  ;~$u$ -- unlocking argument (e.g. signature)

; --- State ---
  StateId = Hash  ;~$\mathsf{sid} = H(\mathsf{CBOR}(\nu, h_\mathsf{st}))$ -- key in Unicity Service registry

; --- Certification ---
  CertificationData = Version Recipient SourceStateHash TransactionHash ExpiresAt UnlockingArgument
      ;~$Q = (\predi, h_\mathsf{st}, h_\mathsf{tx}, \bar\tau_Q, u)$ -- CBOR array[6], submitted to Unicity Service
  ExpiresAt = Timestamp / NULL
      ;~$\bar\tau_Q\in\mathbb{T}_\bot$ -- exclusive request timeout, fixed position
      ;~NULL is the CBOR simple value \texttt{null}, i.e. $\bar\tau_Q=\bot$: the service assigns the deadline

; --- Hash Derivations ---
  ; $\mathsf{id} = H(\mathsf{salt}, \alpha)$~-- token identifier (derived; globally unique across networks)
  ; $h_\mathsf{st} = H(\mathsf{id}, \mathsf{MINT\_SUFFIX})$~-- mint source state hash
  ; $h_\mathsf{st}' = H(h_\mathsf{st}, x)$~-- next state hash

; --- Fungible Token Structures ---
  Asset = AssetId Value  ;~$(\mathsf{aid}, v)$ -- CBOR array[2]
  AssetCollection = 1*256Asset
      ;~canonical CBOR array, strictly ordered by raw $\mathsf{aid}$ bytes
  AssetId = 1*128OCTET  ;~non-empty asset type identifier
  Value = 1*32OCTET
      ;~$1 \leq v < 2^{256}$, minimal unsigned big-endian byte string

  ; These productions describe the decoded tagged CBOR values.
  ; SplitManifestBytes and SplitMintReasonBytes are the complete deterministic
  ; tagged encodings carried in transaction byte-string fields.

  SplitManifestBytes = Bytes
      ;~CBOR tag 39046 applied to \textsf{SplitManifest}
  SplitManifest = 1*256SplitAssetRoot
      ;~tagged CBOR array: $[r_1,\ldots,r_m]$, $1 \leq m \leq 256$
  SplitAssetRoot = Bytes32
      ;~raw SHA-256 RSMST root digest; roots follow source canonical asset order

  SplitMintReasonBytes = Bytes
      ;~CBOR tag 39044 applied to \textsf{SplitMintReason}
  SplitMintReason = Token 1*256SplitAllocationProof
      ;~CBOR array[2]: $[\mathcal{L}_\mathsf{burn},[\bar C_1,\ldots,\bar C_q]]$
      ;~proofs follow output canonical asset order; the token includes the certified burn
      ;~split verification additionally requires output token type bytes to equal source token type bytes

  SplitAllocationProof = *256SplitAllocationStep
      ;~CBOR array: $[(\delta_1,s_1,w_1),\ldots,(\delta_n,s_n,w_n)]$
      ;~zero to 256 sibling entries, leaf-to-root; depths are strictly decreasing
  SplitAllocationStep = BranchDepth SiblingHash SiblingSum
      ;~CBOR array[3]: $[\delta_i,s_i,w_i]$
  BranchDepth = Depth
      ;~CBOR unsigned integer in $0,\ldots,255$
  SiblingHash = Bytes32
      ;~raw SHA-256 sibling subtree digest
  SiblingSum = *32OCTET
      ;~positive minimal unsigned big-endian sum

  SplitOutputCommitment = Bytes32
      ;~$d_j=\mathsf{SHA\text{-}256}(\mathsf{CBOR}(\mathsf{SPLIT\_OUTPUT},\mathsf{id}_\mathsf{src},\alpha,$
      ;~$\qquad\encpred(\predi'_j),\mathsf{salt}_j,\mathsf{id}_j,\mathsf{ty}_j,\auxd'_j))$
      ;~leaf $(\mathsf{id}_j,d_j,v_j)$ binds the allocation to the exact output mint fields
